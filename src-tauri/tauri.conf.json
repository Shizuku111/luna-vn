{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luna VN",
  "version": "../package.json",
  "identifier": "LunaVN",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Luna VN",
        "width": 1280,
        "height": 768,
        "minWidth": 1280,
        "minHeight": 768,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost https://*.bgm.tv https://bgm.tv data: blob:; connect-src ipc: http://ipc.localhost https://api.bgm.tv https://bgm.tv https://*.bgm.tv; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**", "**/.LunaVN/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
